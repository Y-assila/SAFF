# Copy to .env.local for local development (never commit real project values).
# Both values are PUBLIC by design: the anon/publishable key only grants what RLS and
# function grants allow. NEVER put the service-role key in any VITE_ variable.
#
# Defaults below are the standard Supabase local-development values (`npm run db:start`).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Cloudflare Turnstile site key (public). This is Cloudflare's documented TEST key: always passes.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Public production origin encoded in printed shop QR codes, e.g. https://saff.ma (decision D-04).
# Leave empty until the domain is final: QR posters are watermarked "not for printing" until it is a public https origin.
VITE_PUBLIC_APP_URL=
