{
  "name": "saff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:start": "supabase start -x imgproxy,vector,logflare,supavisor,postgres-meta,mailpit,studio,storage-api",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:concurrency": "bash supabase/tests/concurrency/run.sh",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "test:e2e": "playwright test",
    "edge:vendor": "node scripts/vendor-edge-deps.mjs",
    "demo:setup": "node scripts/demo-setup.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.1",
    "i18next": "^27.2.2",
    "libphonenumber-js": "^1.12.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
