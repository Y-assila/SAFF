# Edge Function settings for the LOCAL stack only. Copy to supabase/functions/.env (git-ignored).
# Production values are set with `supabase secrets set` and must be long random secrets.
SAFF_ENVIRONMENT=local
# Origins allowed to call the public functions (the Vite dev server and E2E server).
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174
# DEV-ONLY secrets (public in this file; never reuse anywhere real).
TICKET_HMAC_SECRET_V1=local-dev-only-ticket-secret-0123456789abcdef
RATE_LIMIT_PEPPER=local-dev-only-rate-limit-pepper-0123456789
# Cloudflare's documented TEST secret: always passes for the test site key.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Leave empty to verify with Cloudflare. Offline test double only (allowed when SAFF_ENVIRONMENT=local):
TURNSTILE_VERIFY_URL=
# ── WhatsApp (Milestone 5) ── LOCAL placeholders only; production values via `supabase secrets set`.
APP_BASE_URL=http://localhost:5173
WHATSAPP_TOKEN=local-placeholder-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_APP_SECRET=local-dev-only-meta-app-secret-0123456789
WHATSAPP_VERIFY_TOKEN=local-dev-only-verify-token
WHATSAPP_GRAPH_VERSION=v23.0
# Leave empty to call Meta's Graph API. Offline test double only (allowed when SAFF_ENVIRONMENT=local):
WHATSAPP_API_BASE=
# Shared secret the database (pg_net) uses to wake whatsapp-dispatch; also stored in Supabase Vault.
DISPATCH_SECRET=local-dev-only-dispatch-secret-0123456789abcdef
