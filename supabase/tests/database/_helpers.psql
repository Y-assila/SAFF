-- Shared pgTAP helpers. Included by each test file with \ir; created inside the test transaction,
-- so they are rolled back with it and never reach a real database.
create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

create function tests.create_user(p_email text) returns uuid
language plpgsql security definer set search_path = '' as $$
declare v uuid := gen_random_uuid();
begin
  insert into auth.users (id, instance_id, aud, role, email, raw_app_meta_data, raw_user_meta_data, created_at, updated_at)
  values (v, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email,
          '{}'::jsonb, '{}'::jsonb, now(), now());
  return v;
end $$;

create function tests.create_shop(p_slug text) returns uuid
language sql security definer set search_path = '' as $$
  insert into public.shops (name, slug) values ('Shop ' || p_slug, p_slug) returning id;
$$;

create function tests.add_member(p_shop uuid, p_user uuid, p_role public.shop_role default 'barber') returns void
language sql security definer set search_path = '' as $$
  insert into public.shop_members (shop_id, user_id, role) values (p_shop, p_user, p_role);
$$;

create function tests.open_session(p_shop uuid, p_date date default current_date) returns uuid
language sql security definer set search_path = '' as $$
  insert into public.queue_sessions (shop_id, queue_date) values (p_shop, p_date) returning id;
$$;

-- Inserts a waiting ticket the way join_queue will (allocator under the session row).
create function tests.add_ticket(p_session uuid, p_phone text, p_name text default 'Test') returns uuid
language plpgsql security definer set search_path = '' as $$
declare v_shop uuid; v_num int; v_id uuid;
begin
  update public.queue_sessions set last_ticket_number = last_ticket_number + 1
   where id = p_session returning shop_id, last_ticket_number into v_shop, v_num;
  insert into public.tickets (shop_id, queue_session_id, ticket_number, customer_name, customer_phone,
                              whatsapp_consent, consent_at, consent_text_version)
  values (v_shop, p_session, v_num, p_name, p_phone, true, now(), 'test-v1')
  returning id into v_id;
  return v_id;
end $$;

create function tests.set_status(p_ticket uuid, p_status public.ticket_status) returns void
language sql security definer set search_path = '' as $$
  update public.tickets set status = p_status where id = p_ticket;
$$;

-- Role switching: the JWT claims are what auth.uid() reads.
create function tests.authenticate_as(p_user uuid) returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
  execute 'set local role authenticated';
end $$;

create function tests.as_anon() returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  execute 'set local role anon';
end $$;

create function tests.as_postgres() returns void
language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
end $$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
